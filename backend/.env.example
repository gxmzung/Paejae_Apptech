# Server
PORT=8080
CORS_ORIGIN=*

# School domain (comma separated)
ALLOWED_DOMAINS=pcu.ac.kr

# OTP
OTP_EXPIRES_MIN=10
OTP_RESEND_COOLDOWN_SEC=45
OTP_MAX_PER_HOUR=6

# Mail
MAIL_FROM_NAME=배재Pick
MAIL_FROM_EMAIL=your_sender@gmail.com

# Gmail SMTP (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender@gmail.com
SMTP_PASS=your_app_password_here

# Optional (recommended): makes OTP hashes stronger
OTP_PEPPER=change_this_to_random_long_string